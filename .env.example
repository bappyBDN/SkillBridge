# Copy to .env (cp .env.example .env). Never commit .env.
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev_password
DATABASE_URL=postgresql://skillbridge:skillbridge_dev_password@db:5432/skillbridge
# SECRET_KEY signs sessions and Skill Passports. Use >= 32 random characters, e.g.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The app refuses this placeholder (or a short key) when ENV=production.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: enables LLM skill extraction (CV is PII-redacted first). Leave empty to use the offline rule-based extractor.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# CV-to-profile extraction uses one shared schema/prompt and server-side validation.
# Keep provider keys on the backend only. AI_PROVIDER selects the primary;
# AI_PROVIDER_FALLBACKS is an optional comma-separated failover order.
AI_PROVIDER=groq
# Groq first, then DeepSeek (secondary), then Gemini. Existing calls rotate
# through this order automatically when a provider is rate-limited or fails.
AI_PROVIDER_FALLBACKS=deepseek,gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# DeepSeek: secondary provider and preferred for complex agent tasks.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_MODEL=deepseek-flash
AI_COMPLEX_PROVIDER=deepseek
# Cost guard: estimated AI spend for this window (agent LLM calls stop when used).
AI_MONTHLY_BUDGET_USD=2
# Unset = the budget window is the current calendar month. Set a number of days
# for a rolling window instead.
# AI_BUDGET_WINDOW_DAYS=30
AI_TIMEOUT_SECONDS=90
MAX_CV_TEXT_CHARS=25000
# Descriptive/analytical answers get an advisory hybrid draft (keyword + similarity +
# optional LLM). Every draft waits for admin approval. Cap LLM calls per attempt:
MAX_LLM_EVALUATIONS_PER_ATTEMPT=12
# Spec default cooldown is 14 days (336). 0 lets you demo the re-test immediately.
RETEST_COOLDOWN_HOURS=0
MAX_ATTEMPTS_90D=3
# Every exam is proctored (camera, microphone, screen share, full-screen).
# There is no mode switch. Flag-triggered JPEG screenshots only; no continuous video or audio recordings.
EVIDENCE_RETENTION_DAYS=30
# ---- MCP (Model Context Protocol): verification + candidate learning ----
# Read-only tools exposed over stdio (local hosts) and Streamable HTTP at
# MCP_HTTP_PATH. The in-app MCP console mirrors the same tools at /api/mcp.
# Default off: set MCP_ENABLED=true to mount the transport.
MCP_ENABLED=false
MCP_HTTP_PATH=/mcp
# ---- AI agent features (additive, read/draft-only) ----
# F-A: advisory integrity/honesty summary for reviewers. F-B: question-assist
# drafts that a human must approve into the active bank. Nothing is auto-graded
# or auto-activated. Set the *_ENABLED flags to true to use.
AGENT_INTEGRITY_ENABLED=false
AGENT_INTEGRITY_LLM=false
AGENT_QUESTIONS_ENABLED=false
QUESTION_ASSIST_MCP_URL=
QUESTION_ASSIST_MCP_TOKEN=
QUESTION_ASSIST_MCP_TOOL=search_questions
QUESTION_ASSIST_WEB_MCP_URL=
QUESTION_ASSIST_WEB_MCP_TOKEN=
# ---- Agent platform (one orchestrator, three role copilots) ----
# Draft-only writes to an approval queue; nothing is auto-applied or published.
AGENT_PLATFORM_ENABLED=false
AGENT_LLM_DRAFTS=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_PORT=8080
# Local demo only; disable for public/production deployments.
# Seeding also refuses to run when ENV=production (SB-006).
SEED_DEMO=true
# Fixed demo password (optional). When empty a random one is generated and printed once.
SEED_DEMO_PASSWORD=
# Deployment environment. Use 'production' on any public host: it enables the
# MFA requirement for admin/company-owner roles and blocks demo seeding.
ENV=development
# Auth hardening (SB-003).
PBKDF2_ITERATIONS=600000
SESSION_TTL_SECONDS=604800
MFA_REQUIRED_ROLES=admin,company_owner
# Transactional email for address verification. Without SMTP the deployment
# verifies addresses automatically and tells the user.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173

# GraphRAG question retrieval. Leave service URLs empty to use deterministic SQL fallback.
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_QUESTION_INDEX=skillbridge_questions
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# blank:en = spaCy's deterministic tokenizer (no model download). To use a trained
# pipeline, install it in the image (python -m spacy download en_core_web_sm) and
# set SPACY_MODEL=en_core_web_sm; a missing model falls back to blank English.
SPACY_MODEL=blank:en

# ---- File storage (original uploaded CVs and candidate profile photos) ----
# database = bytes kept in the app database (default; permanent wherever the DB is,
#            including hosts whose container disk is wiped on redeploy)
# local    = files on disk; only permanent on a mounted volume
# s3       = any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO) - use when you scale
STORAGE_BACKEND=database
# STORAGE_LOCAL_DIR=/data/cv_files
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=prod/
# How many CV files to keep per user (older ones are deleted automatically)
KEEP_CV_DOCUMENTS_PER_USER=3

# ---- Database ----
# Local SQLite (no Docker Postgres needed): leave DATABASE_URL empty and use docker-compose.sqlite.yml,
# or run `uvicorn main:app` directly with DB_PATH=./data/skillbridge.db
# Cloud PostgreSQL later: set DATABASE_URL=postgresql://user:pass@host:5432/dbname (no code change)

# AI exam evidence retention (1-90 days; default 30); only alert JPEG snapshots are stored.
EVIDENCE_RETENTION_DAYS=30
# Optional second-pass vision review of alert snapshots. Leave empty to keep all
# analysis on-device. Set to gemini (gemini-2.5-flash) or groq (requires a Groq
# vision model on the account) to send only the already-captured alert JPEG for
# an advisory phone/face/person verdict (never a live stream or audio).
EVIDENCE_VISION_PROVIDER=
# EVIDENCE_VISION_MODEL=gemini-2.5-flash
# EVIDENCE_VISION_TIMEOUT_SECONDS=25

# ---- Runtime, proxy and scaling ----
# Postgres connections per uvicorn worker (psycopg pool max size). Keep
# WEB_CONCURRENCY x PG_POOL_MAX below your database/pooler connection limit.
PG_POOL_MAX=10
# Uvicorn worker processes. Each worker has its own pool and its own copy of the
# background loops (evidence purge, notifications); 1 is right for small hosts.
WEB_CONCURRENCY=1
# Number of reverse proxies in front of the API whose X-Forwarded-For entries are
# trusted when deriving the client IP (rate limits, audit). 1 = Render router or
# the compose nginx. 0 = API exposed directly (ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=1
# Peers uvicorn accepts X-Forwarded-* from. '*' only when the API is reachable
# solely through a trusted proxy; default (unset) is 127.0.0.1.
# FORWARDED_ALLOW_IPS=*
# Seed the synthetic GraphRAG question bank on every boot (idempotent). false =
# seed only when the active bank is empty.
SEED_QUESTION_BANK_ON_BOOT=true
# Comma-separated emails exempt from retake limits for local QA only.
# Ignored when ENV=production.
UNLIMITED_EXAM_EMAILS=

# ---- Frontend (Vite build-time) ----
# Public support address shown in the landing-page FAQ. Leave empty to hide the line.
# VITE_SUPPORT_EMAIL=
